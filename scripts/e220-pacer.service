[Unit]
Description=Ebyte E220 LoRa Hardware Pacing Driver for RTKBase
After=network.target rtkbase.service
Wants=network.target

[Service]
Type=simple
# Running as root ensures uninterrupted access to /dev/ttyAMA0 and BCM GPIO lines:
User=root
WorkingDirectory=/tmp
Environment=PYTHONUNBUFFERED=1
Environment="E220_POWER=30"
EnvironmentFile=-/etc/default/e220-pacer
ExecStart=/usr/bin/python3 -u /usr/local/bin/e220_pacer.py --tcp-connect 127.0.0.1:5016 --port /dev/ttyAMA0 --auto-config --baud 115200 --air-rate 4.8 --packet-size 200 --channel 75 --power $E220_POWER
Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
